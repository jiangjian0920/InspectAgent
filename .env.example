# 必填：Prometheus 地址
PROMETHEUS_URL=http://127.0.0.1:9090

# 可选：智谱 GLM。留空则使用规则回退解析，不影响巡检执行。
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.3
ZHIPU_BASE_URL=
ZHIPU_TIMEOUT_SECONDS=180

# 报告模式：template（默认，无额外模型调用）或 llm_summary
REPORT_MODE=template

# 查询策略
DEFAULT_TIME_RANGE=2h
DEFAULT_STEP_SECONDS=60
MAX_TIME_RANGE_DAYS=30
MAX_QUERY_COUNT=40
MAX_SERIES=200
DEFAULT_LIMIT=10
PROMETHEUS_TIMEOUT_SECONDS=30

# 配置路径覆盖（可选）
CONFIG_DIR=
ASSETS_PATH=
POLICIES_PATH=
SERVER_SKILL_DIR=

LOG_LEVEL=INFO
